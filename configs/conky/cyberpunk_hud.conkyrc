conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    diskio_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 8192,
    update_interval = 1.0,

    -- Window Styling (Cyberpunk Neon Card)
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 190,
    own_window_colour = '090a10',
    border_inner_margin = 20,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = false,
    draw_outline = false,
    draw_graph_borders = false,

    gap_x = 35,
    gap_y = 55,
    minimum_width = 300,
    maximum_width = 300,

    use_xft = true,
    font = 'JetBrains Mono:size=9',
    xftalpha = 0.95,
    override_utf8_locale = true,
    uppercase = false,

    -- Cyberpunk Palette
    default_color = '#e0e7ff',
    color1 = '#00f5d4', -- Neon Cyan
    color2 = '#fee440', -- Neon Yellow
    color3 = '#f72585', -- Neon Pink / Magenta
    color4 = '#7209b7', -- Neon Violet
    color5 = '#4cc9f0', -- Electric Blue
    color6 = '#4361ee', -- Cobalt Blue
    color7 = '#3a0ca3', -- Dark Blue
}

conky.text = [[
${color1}${font JetBrains Mono:size=30:bold}${time %H:%M}${font}${color3}${font JetBrains Mono:size=14:bold} ${time %S}${font}
${voffset 2}${color2}${font JetBrains Mono:size=10:bold}⚡ CYBER HUD // ${time %Y.%m.%d}${font}

${voffset 6}${color5}${font JetBrains Mono:size=9:bold}[ TELEMETRY CORES ] ${hr 1}${font}
${voffset 4}${color}CPU LOAD: ${color1}${cpu}%${alignr}${color1}${cpubar 6,140}
${color3}${cpugraph 22,300 00f5d4 f72585 -l}
${voffset 2}${color}RAM USED: ${color2}${memperc}%${alignr}${color2}${membar 6,140}
${color}MEM: ${color5}$mem ${color}/ ${color5}$memmax

${voffset 6}${color5}${font JetBrains Mono:size=9:bold}[ STORAGE & IO ] ${hr 1}${font}
${voffset 4}${color}ROOT NVME: ${color3}${fs_used_perc /}%${alignr}${color3}${fs_bar 6,140 /}
${voffset 2}${color}NET IN:  ${color1}${downspeed wlo1}/s${alignr}${color}NET OUT: ${color2}${upspeed wlo1}/s

${voffset 6}${color5}${font JetBrains Mono:size=9:bold}[ THREAD MATRIX ] ${hr 1}${font}
${voffset 4}${color1}>> ${top name 1}${alignr}${color3}${top cpu 1}%
${color1}>> ${top name 2}${alignr}${color3}${top cpu 2}%
${color1}>> ${top name 3}${alignr}${color3}${top cpu 3}%
]]
