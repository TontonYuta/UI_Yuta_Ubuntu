conky.config = {
    alignment = 'top_left',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    diskio_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 16384,
    update_interval = 1.0,

    -- Window Styling (Ultra Modern Frosted Glass Card)
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 180,
    own_window_colour = '0f111a',
    border_inner_margin = 24,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = false,
    draw_outline = false,
    draw_graph_borders = false,

    gap_x = 45,
    gap_y = 55,
    minimum_width = 330,
    maximum_width = 330,

    use_xft = true,
    font = 'Inter:size=10',
    xftalpha = 0.95,
    override_utf8_locale = true,
    uppercase = false,

    -- Palette (Tokyo Neon / Cyber Glass)
    default_color = '#cad3f5',
    color1 = '#7aa2f7', -- Primary Accent Blue
    color2 = '#bb9af7', -- Soft Purple
    color3 = '#7dcfff', -- Vivid Cyan
    color4 = '#9ece6a', -- Emerald Green
    color5 = '#e0af68', -- Sunset Orange
    color6 = '#565f89', -- Muted Slate
    color7 = '#f7768e', -- Coral Pink
    color8 = '#c0caf5', -- Frost White
}

conky.text = [[
${color1}${font SF Pro Display:bold:size=46}${time %H:%M}${font}${color3}${font Inter Display:size=16:bold} ${time %S}${font}
${voffset 2}${color2}${font SF Pro Display:bold:size=13}${time %A}${font}${color8}${font Inter:size=12}, ${time %d %B %Y}${font}
${voffset 4}${color6}${font Inter:size=9}────────────────────────────────────────${font}

${voffset 2}${color3}${font Inter:size=10:bold}📍 ${execi 900 python3 ~/.config/conky/scripts/weather.py --city}, VIETNAM${alignr}${color5}${execi 900 python3 ~/.config/conky/scripts/weather.py --high-low}${font}
${voffset 6}${color8}${font SF Pro Display:bold:size=28}${execi 900 python3 ~/.config/conky/scripts/weather.py --icon} ${execi 900 python3 ~/.config/conky/scripts/weather.py --temp}${font}${alignr}${voffset -6}${color1}${font Inter:bold:size=12}${execi 900 python3 ~/.config/conky/scripts/weather.py --condition}${font}
${voffset 6}${color}${font Inter:size=9}💧 Độ ẩm: ${color3}${execi 900 python3 ~/.config/conky/scripts/weather.py --humidity}${font}${alignr}${color}💨 Gió: ${color5}${execi 900 python3 ~/.config/conky/scripts/weather.py --wind}${font}

${voffset 6}${color6}${font Inter:size=9}────────────────────────────────────────${font}
${voffset 2}${color2}${font Inter:size=9:italic}${execi 30 python3 ~/.config/conky/scripts/helper.py --media}${font}
]]
