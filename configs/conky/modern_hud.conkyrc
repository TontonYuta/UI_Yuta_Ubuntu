conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    diskio_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 8192,
    update_interval = 1.0,

    -- Window Styling (Sleek Frosted Glass Card)
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 175,
    own_window_colour = '141620',
    border_inner_margin = 22,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = false,
    draw_outline = false,
    draw_graph_borders = false,

    gap_x = 35,
    gap_y = 55,
    minimum_width = 290,
    maximum_width = 290,

    use_xft = true,
    font = 'Inter:size=10',
    xftalpha = 0.9,
    override_utf8_locale = true,
    uppercase = false,

    -- Tokyo Night Palette
    default_color = '#c0caf5',
    color1 = '#7aa2f7', -- Blue (Primary Accent)
    color2 = '#bb9af7', -- Purple
    color3 = '#7dcfff', -- Cyan
    color4 = '#9ece6a', -- Green
    color5 = '#e0af68', -- Orange
    color6 = '#565f89', -- Muted Gray
    color7 = '#f7768e', -- Red Alert
}

conky.text = [[
${color1}${font Inter Display:size=34:bold}${time %H:%M}${font}${color3}${font Inter Display:size=14:bold} ${time %S}${font}
${voffset 2}${color2}${font Inter:size=11:bold}${time %A, %d %B %Y}${font}

${voffset 6}${color6}${font Inter:size=9:bold}HỆ THỐNG ${hr 1}${font}
${voffset 4}${color}CPU (${cpu}%)${alignr}${color1}${cpubar 6,140}
${color6}${cpugraph 20,290 7aa2f7 7dcfff -l}
${voffset 2}${color}RAM ($memperc%)${alignr}${color3}${membar 6,140}
${color6}Đã dùng: $mem / $memmax

${voffset 6}${color6}${font Inter:size=9:bold}LƯU TRỮ & MẠNG ${hr 1}${font}
${voffset 4}${color}Ổ đĩa (/): ${fs_used_perc /}%${alignr}${color4}${fs_bar 6,140 /}
${voffset 2}${color}Tải xuống:${alignr}${color3}${downspeed wlo1}/s
${color}Tải lên:${alignr}${color5}${upspeed wlo1}/s

${voffset 6}${color6}${font Inter:size=9:bold}TRÍCH DẪN ${hr 1}${font}
${voffset 4}${color2}${font Inter:italic:size=9}"${execi 1800 python3 -c '
import random
q = [
    "Stay focused. Stay curious.",
    "Dream big and dare to fail.",
    "Small steps lead to big changes.",
    "Creativity is intelligence having fun.",
    "Simplicity is the soul of efficiency.",
    "Do what you love, love what you do."
]
print(random.choice(q))
'}"${font}
]]
