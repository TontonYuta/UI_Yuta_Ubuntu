conky.config = {
    alignment = 'middle_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    default_color = '#c0caf5',
    default_outline_color = '#1a1b26',
    default_shade_color = '#1a1b26',
    double_buffer = true,
    draw_borders = false,
    draw_graph_borders = true,
    draw_outline = false,
    draw_shades = false,
    use_xft = true,
    font = 'JetBrains Mono:size=10',
    gap_x = 35,
    gap_y = 0,
    net_avg_samples = 2,
    no_buffers = true,
    out_to_console = false,
    out_to_ncurses = false,
    out_to_stderr = false,
    out_to_x = true,
    extra_newline = false,
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    stippled_borders = 0,
    update_interval = 1.0,
    uppercase = false,
    use_spacer = 'none',
    show_graph_scale = false,
    show_graph_range = false,
    color1 = '#7aa2f7', -- Tokyo Blue
    color2 = '#bb9af7', -- Tokyo Purple
    color3 = '#9ece6a', -- Tokyo Green
    color4 = '#e0af68', -- Tokyo Orange
    color5 = '#f7768e', -- Tokyo Red
    color6 = '#7dcfff', -- Tokyo Cyan
}

conky.text = [[
${font JetBrains Mono:size=28:bold}${color1}${time %H:%M:%S}${font}
${voffset -10}${color2}${font Inter:size=12:bold}${time %A, %d %B %Y}${font}
${voffset 10}${color1}${font Inter:size=11:bold}HỆ THỐNG ${hr 2}${font}
${color}HĐH:$alignr${execi 99999 lsb_release -d -s | tr -d '"'}
${color}Kernel:$alignr$kernel
${color}Thời gian chạy:$alignr$uptime

${voffset 6}${color3}${font Inter:size=11:bold}CPU (i7-8665U) ${hr 2}${font}
${color}Tổng tải: ${cpu}%$alignr${color3}${cpubar 8,140}
${color}Lõi 1-2: ${cpu cpu1}% / ${cpu cpu2}%$alignr${color6}${cpubar cpu1 6,65} ${cpubar cpu2 6,65}
${color}Lõi 3-4: ${cpu cpu3}% / ${cpu cpu4}%$alignr${color6}${cpubar cpu3 6,65} ${cpubar cpu4 6,65}
${color}Lõi 5-6: ${cpu cpu5}% / ${cpu cpu6}%$alignr${color6}${cpubar cpu5 6,65} ${cpubar cpu6 6,65}
${color}Lõi 7-8: ${cpu cpu7}% / ${cpu cpu8}%$alignr${color6}${cpubar cpu7 6,65} ${cpubar cpu8 6,65}
${color6}${cpugraph 24,300 7aa2f7 f7768e}

${voffset 6}${color4}${font Inter:size=11:bold}BỘ NHỚ & Ổ CỨNG ${hr 2}${font}
${color}RAM: $mem / $memmax ($memperc%)$alignr${color4}${membar 8,100}
${color}Swap: $swap / $swapmax$alignr${color4}${swapbar 8,100}
${color}Root (/): ${fs_used /} / ${fs_size /}$alignr${color4}${fs_bar 8,100 /}

${voffset 6}${color5}${font Inter:size=11:bold}TIẾN TRÌNH HÀNG ĐẦU ${hr 2}${font}
${color}${top name 1}$alignr${color5}${top cpu 1}% ${top mem 1}%
${color}${top name 2}$alignr${color5}${top cpu 2}% ${top mem 2}%
${color}${top name 3}$alignr${color5}${top cpu 3}% ${top mem 3}%

${voffset 6}${color6}${font Inter:size=11:bold}MẠNG WI-FI (wlo1) ${hr 2}${font}
${color}Tải xuống: ${downspeed wlo1}/s $alignr${downspeedgraph wlo1 20,130 7aa2f7 7dcfff}
${color}Tải lên: ${upspeed wlo1}/s $alignr${upspeedgraph wlo1 20,130 f7768e e0af68}
]]
