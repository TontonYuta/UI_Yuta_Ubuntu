conky.config = {
    alignment = 'bottom_left',
    background = false,
    border_width = 0,
    cpu_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 16384,
    update_interval = 0.2,

    -- Window Styling (Floating Borderless Soft Aesthetic)
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = true,
    own_window_argb_visual = true,
    border_inner_margin = 10,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = true,
    default_shade_color = '#000000',
    draw_outline = false,
    draw_graph_borders = false,

    gap_x = 55,
    gap_y = 65,
    minimum_width = 380,
    maximum_width = 380,

    use_xft = true,
    font = 'Inter:size=10',
    xftalpha = 0.95,
    override_utf8_locale = true,
    uppercase = false,

    -- Palette
    default_color = '#c0caf5',
    color1 = '#7aa2f7', -- Blue
    color2 = '#bb9af7', -- Lavender
    color3 = '#7dcfff', -- Cyan
    color4 = '#9ece6a', -- Emerald
    color5 = '#e0af68', -- Amber
    color6 = '#565f89', -- Slate
    color7 = '#f7768e', -- Pink
    color8 = '#ffffff', -- White
}

conky.text = [[
${color3}${font SF Pro Display:bold:size=11}♪ REALTIME LYRICS & MUSIC STUDIO${font}
${voffset 2}${color8}${font SF Pro Display:bold:size=13}${execi 1 python3 ~/.config/conky/scripts/music_engine.py --track}${font}
${voffset 2}${color6}${font JetBrains Mono:size=9}${execi 1 python3 ~/.config/conky/scripts/music_engine.py --progress}${font}
${voffset 4}${color6}${font Inter:size=8}──────────────────────────────────────────${font}

${voffset 2}${color2}${font Inter:bold:size=13}♪ "${execi 1 python3 ~/.config/conky/scripts/music_engine.py --lyric}"${font}
${voffset 2}${color6}${font Inter:size=10}${execi 1 python3 ~/.config/conky/scripts/music_engine.py --next-lyric}${font}

${voffset 4}${color6}${font Inter:size=8}──────────────────────────────────────────${font}
${voffset 2}${font JetBrains Mono:size=12}${execp cat /tmp/cava_bars.txt 2>/dev/null || echo ""}${font}
]]
