conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 1,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    diskio_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 16384,
    update_interval = 1.0,

    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = false,
    own_window_argb_visual = true,
    own_window_argb_value = 195,
    own_window_colour = '090a10',
    border_inner_margin = 24,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = false,
    draw_outline = false,

    gap_x = 45,
    gap_y = 55,
    minimum_width = 330,
    maximum_width = 330,

    use_xft = true,
    font = 'JetBrains Mono:size=9',
    override_utf8_locale = true,

    default_color = '#e0e6ed',
    color1 = '#fcee0a',
    color2 = '#00f0ff',
    color3 = '#ff0055',
    color4 = '#00ff66',
    color5 = '#ffaa00',
    color6 = '#3a3f58',
    color8 = '#ffffff',
}

conky.text = [[
${color1}${font JetBrains Mono:bold:size=13}> SYSTEM_ONLINE // ${execi 60 python3 ~/.config/conky/scripts/helper.py --greeting-en}${font}
${voffset 2}${color6}${font JetBrains Mono:size=9}NODE: ${color8}${nodename} ${color6}| PWR: ${color4}${execi 10 python3 ~/.config/conky/scripts/helper.py --battery}${font}
${voffset 4}${color6}${font JetBrains Mono:size=9}════════════════════════════════════════${font}

${voffset 4}${color1}${font JetBrains Mono:bold:size=10}[CPU] MATRIX CORE${alignr}${color8}${cpu}%  ${color6}(${freq_g}GHz)${font}
${voffset 2}${color1}${cpubar 6,330}
${voffset 2}${color6}${cpugraph 22,330 fcee0a 00f0ff -l}

${voffset 4}${color2}${font JetBrains Mono:bold:size=10}[RAM] MEMORY BUFFER${alignr}${color8}$memperc%  ${color6}($mem / $memmax)${font}
${voffset 2}${color2}${membar 6,330}

${voffset 4}${color4}${font JetBrains Mono:bold:size=10}[SSD] SYSTEM DRIVE (/)${alignr}${color8}${fs_used_perc /}%  ${color6}(FREE: ${fs_free /})${font}
${voffset 2}${color4}${fs_bar 6,330 /}

${voffset 6}${color6}${font JetBrains Mono:size=9}════════════════════════════════════════${font}
${voffset 2}${color5}${font JetBrains Mono:bold:size=10}[NET] INTERFACE (${gw_iface})${alignr}${color6}IP: ${color8}${addr ${gw_iface}}${font}
${voffset 4}${color}DL SPEED:${alignr}${color2}${downspeed ${gw_iface}}/s ${color6}(TOTAL: ${totaldown ${gw_iface}})
${color}UL SPEED:${alignr}${color5}${upspeed ${gw_iface}}/s ${color6}(TOTAL: ${totalup ${gw_iface}})

${voffset 6}${color6}${font JetBrains Mono:size=9}════════════════════════════════════════${font}
${voffset 2}${color3}${font JetBrains Mono:bold:size=10}[TOP] ACTIVE THREADS${alignr}${color6}CPU / RAM${font}
${voffset 2}${color8}${top name 1}${alignr}${color1}${top cpu 1}% ${color6}| ${color2}${top mem 1}%
${color8}${top name 2}${alignr}${color1}${top cpu 2}% ${color6}| ${color2}${top mem 2}%
${color8}${top name 3}${alignr}${color1}${top cpu 3}% ${color6}| ${color2}${top mem 3}%
]]
