conky.config = {
    alignment = 'top_right',
    background = false,
    border_width = 0,
    cpu_avg_samples = 2,
    net_avg_samples = 2,
    diskio_avg_samples = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 16384,
    update_interval = 1.0,

    -- Window Styling (Sci-Fi Hologram Floating HUD)
    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'desktop',
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    own_window_transparent = true,
    own_window_argb_visual = true,
    border_inner_margin = 10,
    border_outer_margin = 0,
    draw_borders = false,
    draw_shades = true,
    default_shade_color = '#000000',
    draw_outline = false,
    draw_graph_borders = false,

    gap_x = 55,
    gap_y = 65,
    minimum_width = 330,
    maximum_width = 330,

    use_xft = true,
    font = 'JetBrains Mono:size=9',
    xftalpha = 0.95,
    override_utf8_locale = true,
    uppercase = false,

    -- SandSux Sci-Fi HUD Palette
    default_color = '#e0f7fa',
    color0 = '#39c9c4', -- Cyan
    color1 = '#d59704', -- Amber Gold
    color2 = '#00f0ff', -- Neon Cyan
    color3 = '#ff0055', -- Pink
    color4 = '#00ff88', -- Green
    color5 = '#e0af68', -- Amber
    color6 = '#415a77', -- Slate
    color8 = '#ffffff', -- White
}

conky.text = [[
${color2}${font JetBrains Mono:bold:size=11}>>> SYSTEM TELEMETRY // HUD MONITOR${font}
${color6}${font JetBrains Mono:size=8}──────────────────────────────────────────${font}

${voffset 2}${color0}${font JetBrains Mono:bold:size=10}[CPU_CORE] PROCESSING MATRIX${alignr}${color8}${cpu}%  ${color6}(${freq_g}GHz)${font}
${voffset 3}${color0}${cpubar 5,330}
${voffset 2}${color6}${cpugraph 20,330 39c9c4 d59704 -l}

${voffset 4}${color1}${font JetBrains Mono:bold:size=10}[RAM_BUFFER] MEMORY ARRAY${alignr}${color8}$memperc%  ${color6}($mem / $memmax)${font}
${voffset 3}${color1}${membar 5,330}

${voffset 4}${color4}${font JetBrains Mono:bold:size=10}[SSD_SECTOR] SYSTEM STORAGE (/)${alignr}${color8}${fs_used_perc /}%  ${color6}(FREE: ${fs_free /})${font}
${voffset 3}${color4}${fs_bar 5,330 /}

${voffset 6}${color6}${font JetBrains Mono:size=8}──────────────────────────────────────────${font}
${voffset 2}${color2}${font JetBrains Mono:bold:size=10}[NET_COMMS] INTERFACE (${gw_iface})${alignr}${color6}IP: ${color8}${addr ${gw_iface}}${font}
${voffset 4}${color}DL_STREAM:${alignr}${color0}${downspeed ${gw_iface}}/s ${color6}(TOTAL: ${totaldown ${gw_iface}})
${color}UL_STREAM:${alignr}${color1}${upspeed ${gw_iface}}/s ${color6}(TOTAL: ${totalup ${gw_iface}})

${voffset 6}${color6}${font JetBrains Mono:size=8}──────────────────────────────────────────${font}
${voffset 2}${color3}${font JetBrains Mono:bold:size=10}[ACTIVE_THREADS] TOP PROCESSES${alignr}${color6}CPU / RAM${font}
${voffset 2}${color8}1. ${top name 1}${alignr}${color0}${top cpu 1}% ${color6}| ${color1}${top mem 1}%
${color8}2. ${top name 2}${alignr}${color0}${top cpu 2}% ${color6}| ${color1}${top mem 2}%
${color8}3. ${top name 3}${alignr}${color0}${top cpu 3}% ${color6}| ${color1}${top mem 3}%
]]
