{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "ubuntu_small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜ ",
    "color": {
      "keys": "cyan",
      "title": "magenta"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "OS       ",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "Host     ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "Kernel   ",
      "keyColor": "cyan"
    },
    {
      "type": "uptime",
      "key": "Uptime   ",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "Packages ",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "Shell    ",
      "keyColor": "green"
    },
    {
      "type": "de",
      "key": "Desktop  ",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "Terminal ",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "CPU      ",
      "keyColor": "magenta"
    },
    {
      "type": "gpu",
      "key": "GPU      ",
      "keyColor": "magenta"
    },
    {
      "type": "memory",
      "key": "Memory   ",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "Disk (/) ",
      "keyColor": "red"
    },
    {
      "type": "battery",
      "key": "Battery  ",
      "keyColor": "green"
    },
    "break",
    "colors"
  ]
}
