import re

def strip_ansi(text):
    return re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', text)

def render_box_header(title, subtitle=None):
    term_width = min(shutil.get_terminal_size((90, 24)).columns, 88)
    
    line_top = f"{C_SLATE}╭" + "─" * (term_width - 2) + f"╮{C_RESET}"
    line_bot = f"{C_SLATE}╰" + "─" * (term_width - 2) + f"╯{C_RESET}"
    
    t1 = f" {C_BLUE}{C_BOLD}🐱 KITTY-OS 2.0 • BẢNG HƯỚNG DẪN & TRA CỨU PHÍM TẮT{C_RESET}"
    t2 = f" {C_MUTED}Phím chính: {C_YELLOW}{C_BOLD}Super{C_RESET}{C_MUTED} (Win) • Trình duyệt: {C_ORANGE}{C_BOLD}Firefox 🦊{C_RESET}{C_MUTED} • Tra cứu: {C_CYAN}kitty-help <từ khóa>{C_RESET}"
    
    pad1 = term_width - 2 - len(strip_ansi(t1))
    pad2 = term_width - 2 - len(strip_ansi(t2))
    
    row1 = f"{C_SLATE}│{C_RESET}" + t1 + (" " * max(0, pad1)) + f"{C_SLATE}│{C_RESET}"
    row2 = f"{C_SLATE}│{C_RESET}" + t2 + (" " * max(0, pad2)) + f"{C_SLATE}│{C_RESET}"
    
    print(line_top)
    print(row1)
    print(row2)
    print(line_bot)

def render_section(section):
    print(f"\n{section['color']}{C_BOLD}{section['title']}{C_RESET}")
    print(f"{C_SLATE}  " + "─" * 74 + f"{C_RESET}")
    for key, desc in section["items"]:
        key_styled = f"{C_YELLOW}{key}{C_RESET}".ljust(44)
        print(f"    {key_styled} {C_SLATE}➜{C_RESET}  {C_WHITE}{desc}{C_RESET}")

def search_items(query):
    query_lower = query.lower()
    matches = []
    sound_keywords = ["sound", "audio", "volume", "am thanh", "am luong", "tai nghe", "speaker", "headphone"]
    for sec in SECTIONS:
        sec_match = False
        if query_lower in sec["id"] or query_lower in sec["title"].lower():
            sec_match = True
        if sec["id"] == "hardware" and any(k in query_lower for k in sound_keywords):
            sec_match = True
        for key, desc in sec["items"]:
            if sec_match or query_lower in key.lower() or query_lower in desc.lower():
                matches.append((sec["title"], sec["color"], key, desc))
    return matches

def main():
    args = sys.argv[1:]
    
    if not args:
        # Render Full Cheatsheet
        render_box_header("KITTY-OS 2.0")
        for sec in SECTIONS:
            render_section(sec)
        print(f"\n{C_SLATE}  " + "─" * 74 + f"{C_RESET}")
        print(f"{C_MUTED}  💡 Mẹo: Nhấn {C_CYAN}Super + F1{C_MUTED} trong Sway hoặc {C_CYAN}Ctrl+a ?{C_MUTED} trong Tmux để mở nhanh popup!{C_RESET}\n")
        return

    query = " ".join(args).strip().lower()

    # Direct category filter
    matched_sec = None
    for sec in SECTIONS:
        if query in sec["id"] or query == sec["id"][:3]:
            matched_sec = sec
            break
            
    if matched_sec:
        render_box_header(f"KITTY-OS 2.0 • {matched_sec['id'].upper()}")
        render_section(matched_sec)
        print(f"\n{C_SLATE}  " + "─" * 74 + f"{C_RESET}\n")
        return

    # Keyword Search
    results = search_items(query)
    render_box_header(f"KẾT QUẢ TÌM KIẾM: '{query}'")
    
    if not results:
        print(f"\n  {C_RED}❌ Không tìm thấy phím tắt phù hợp với từ khóa:{C_RESET} {C_YELLOW}{query}{C_RESET}")
        print(f"  {C_MUTED}👉 Thử tìm với: sway, firefox, split, zoom, tab, ram, sound, workspace...{C_RESET}\n")
        return
        
    print(f"\n  {C_GREEN}🔍 Tìm thấy {len(results)} phím tắt / lệnh liên quan đến '{query}':{C_RESET}\n")
    current_sec = None
    for sec_title, sec_color, key, desc in results:
        if sec_title != current_sec:
            current_sec = sec_title
            print(f"  {sec_color}{C_BOLD}{sec_title}{C_RESET}")
        key_styled = f"{C_YELLOW}{key}{C_RESET}".ljust(44)
        print(f"    {key_styled} {C_SLATE}➜{C_RESET}  {C_WHITE}{desc}{C_RESET}")
    print(f"\n{C_SLATE}  " + "─" * 74 + f"{C_RESET}\n")

if __name__ == "__main__":
    main()
